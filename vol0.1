  <!-- トースト通知 -->
  <div id="toast" role="status" aria-live="polite" class="pointer-events-none fixed top-14 left-1/2 -translate-x-1/2 px-4 py-2 rounded-full bg-slate-900/95 text-white text-xs font-medium shadow-lg opacity-0 transition-opacity duration-200 z-50 whitespace-nowrap">
    メッセージ
  </div>

  <script>
    // --- 定数 ---
    const ALLOWED_MIME_TYPES = ['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/avif', 'image/bmp'];
    const MAX_FILE_SIZE_BYTES = 35 * 1024 * 1024;
    const MAX_CANVAS_DIMENSION = 3200;
    const MAX_HISTORY = 40;
    const MAX_EFFECT_CACHE = 4; // モバイルSafariメモリ保護のため厳格に制限
    const DRAG_CREATE_THRESHOLD_PX = 8;

    // --- DOM ---
    const canvasContainer = document.getElementById('canvasContainer');
    const mainCanvas = document.getElementById('mainCanvas');
    const ctx = mainCanvas.getContext('2d');
    const emptyDropOverlay = document.getElementById('emptyDropOverlay');
    const dropZone = document.getElementById('dropZone');
    const sidebarBody = document.getElementById('sidebarBody');
    const floatingHud = document.getElementById('floatingHud');
    const zoomHud = document.getElementById('zoomHud');
    const zoomLabel = document.getElementById('zoomLabel');
    const hintPill = document.getElementById('hintPill');
    const loupeContainer = document.getElementById('loupeContainer');
    const loupeCanvas = document.getElementById('loupeCanvas');
    const loupeCtx = loupeCanvas.getContext('2d');

    const sliderStrength = document.getElementById('sliderStrength');
    const sliderOpacity = document.getElementById('sliderOpacity');
    const sliderFeather = document.getElementById('sliderFeather');
    const sliderShapeParam = document.getElementById('sliderShapeParam');
    const valStrength = document.getElementById('valStrength');
    const valOpacity = document.getElementById('valOpacity');
    const valFeather = document.getElementById('valFeather');
    const valShapeParam = document.getElementById('valShapeParam');
    const labelShapeParam = document.getElementById('labelShapeParam');
    const strengthGroup = document.getElementById('strengthGroup');
    const featherGroup = document.getElementById('featherGroup');
    const shapeParamGroup = document.getElementById('shapeParamGroup');
    const layerList = document.getElementById('layerList');

    const btnUndo = document.getElementById('btnUndo');
    const btnRedo = document.getElementById('btnRedo');
    const btnClearAll = document.getElementById('btnClearAll');
    const btnXPreview = document.getElementById('btnXPreview');
    const btnCopyClipboard = document.getElementById('btnCopyClipboard');
    const btnExport = document.getElementById('btnExport');
    const exportFormat = document.getElementById('exportFormat');
    const btnToggleMobilePanel = document.getElementById('btnToggleMobilePanel');

    // --- 状態 ---
    const state = {
      sourceImage: null,
      imgWidth: 0,
      imgHeight: 0,
      layers: [],
      selectedLayerId: null,
      activeTool: 'rect',
      brushSize: 36,
      isComparing: false,
      hasUnsavedChanges: false,
      mobilePanelCollapsed: false,
      history: [],
      historyIndex: -1,
      effectCache: new Map(),
      hoverImgPos: null,
      renderRafId: null,

      view: {
        scale: 1,
        offsetX: 0,
        offsetY: 0,
      },

      gesture: {
        mode: 'none',
        handle: null,
        startImgX: 0,
        startImgY: 0,
        startClientX: 0,
        startClientY: 0,
        origRect: null,
        lastClientX: 0,
        lastClientY: 0,
        initialPinchDist: 0,
        initialScale: 1,
        didMutate: false,
      }
    };

    const supportsCanvasFilter = (() => {
      try {
        const testC = document.createElement('canvas');
        testC.width = 10;
        testC.height = 10;
        const tCtx = testC.getContext('2d');
        if (typeof tCtx.filter === 'undefined') return false;
        tCtx.fillStyle = '#ffffff';
        tCtx.fillRect(4, 4, 2, 2);
        tCtx.filter = 'blur(2px)';
        tCtx.drawImage(testC, 0, 0);
        return tCtx.getImageData(2, 5, 1, 1).data[3] > 0;
      } catch (e) {
        return false;
      }
    })();

    const frostedNoisePattern = (() => {
      const nc = document.createElement('canvas');
      nc.width = 96;
      nc.height = 96;
      const nctx = nc.getContext('2d');
      const imgData = nctx.createImageData(96, 96);
      for (let i = 0; i < imgData.data.length; i += 4) {
        const v = Math.random() > 0.5 ? 255 : 0;
        imgData.data[i] = v;
        imgData.data[i + 1] = v;
        imgData.data[i + 2] = v;
        imgData.data[i + 3] = 16;
      }
      nctx.putImageData(imgData, 0, 0);
      return nc;
    })();

    function getScaleFactor() {
      if (!state.imgWidth || !state.imgHeight) return 1;
      return Math.max(state.imgWidth, state.imgHeight) / 1000;
    }

    function getScaledBrushSize() {
      return Math.max(6, Math.round(state.brushSize * getScaleFactor()));
    }

    let toastTimer = null;
    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.remove('opacity-0');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.add('opacity-0'), 2400);
    }

    function scheduleRender() {
      if (state.renderRafId) return;
      state.renderRafId = requestAnimationFrame(() => {
        state.renderRafId = null;
        render();
      });
    }

    // --- Undo / Redo 履歴管理 ---
    function cloneLayers(layers) {
      return layers.map(l => ({
        id: l.id,
        name: l.name,
        shapeType: l.shapeType,
        blurType: l.blurType,
        strength: l.strength,
        opacity: l.opacity,
        feather: l.feather,
        borderRadius: l.borderRadius,
        badge: l.badge || '',
        visible: l.visible,
        rect: { ...l.rect },
        strokes: l.strokes.map(s => ({ size: s.size, points: s.points.map(p => ({ x: p.x, y: p.y })) })),
        erasers: l.erasers.map(e => ({ size: e.size, points: e.points.map(p => ({ x: p.x, y: p.y })) }))
      }));
    }

    function pushHistory() {
      if (!state.sourceImage) return;
      const snapshot = {
        layers: cloneLayers(state.layers),
        selectedLayerId: state.selectedLayerId,
      };
      state.history = state.history.slice(0, state.historyIndex + 1);
      state.history.push(snapshot);
      if (state.history.length > MAX_HISTORY) {
        state.history.shift();
      } else {
        state.historyIndex++;
      }
      state.hasUnsavedChanges = true;
      updateHistoryButtons();
    }

    function applyHistorySnapshot(snapshot) {
      state.layers = cloneLayers(snapshot.layers);
      state.selectedLayerId = snapshot.selectedLayerId;
      const sel = getSelectedLayer();
      if (sel) syncControlsFromLayer(sel);
      renderLayerList();
      render();
      updateHistoryButtons();
    }

    function undo() {
      if (state.historyIndex <= 0) return;
      state.historyIndex--;
      applyHistorySnapshot(state.history[state.historyIndex]);
      showToast('1つ前の状態に戻しました');
    }

    function redo() {
      if (state.historyIndex >= state.history.length - 1) return;
      state.historyIndex++;
      applyHistorySnapshot(state.history[state.historyIndex]);
      showToast('操作をやり直しました');
    }

    function updateHistoryButtons() {
      btnUndo.disabled = !state.sourceImage || state.historyIndex <= 0;
      btnRedo.disabled = !state.sourceImage || state.historyIndex >= state.history.length - 1;
    }

    function updateEditorAvailability() {
      const hasImg = Boolean(state.sourceImage);
      emptyDropOverlay.classList.toggle('hidden', hasImg);
      floatingHud.classList.toggle('hidden', !hasImg);
      zoomHud.classList.toggle('hidden', !hasImg);
      hintPill.classList.toggle('hidden', !hasImg);
      sidebarBody.classList.toggle('opacity-45', !hasImg);
      sidebarBody.classList.toggle('pointer-events-none', !hasImg);
      btnClearAll.disabled = !hasImg;
      btnXPreview.disabled = !hasImg;
      btnCopyClipboard.disabled = !hasImg;
      btnExport.disabled = !hasImg;
      updateHistoryButtons();
    }

    // --- 画像検証＆読み込み ---
    function processUploadedFile(file) {
      if (!file) return;
      if (!ALLOWED_MIME_TYPES.includes(file.type)) {
        showToast('対応していない形式です（PNG / JPEG / WebP等を選択してください）');
        return;
      }
      if (file.size > MAX_FILE_SIZE_BYTES) {
        showToast('ファイルサイズが大きすぎます（35MB以下を選択してください）');
        return;
      }

      const objectUrl = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(objectUrl);
        let targetW = img.naturalWidth || img.width;
        let targetH = img.naturalHeight || img.height;
        if (!targetW || !targetH) {
          showToast('画像の読み込みに失敗しました');
          return;
        }
        if (targetW > MAX_CANVAS_DIMENSION || targetH > MAX_CANVAS_DIMENSION) {
          const ratio = Math.min(MAX_CANVAS_DIMENSION / targetW, MAX_CANVAS_DIMENSION / targetH);
          targetW = Math.round(targetW * ratio);
          targetH = Math.round(targetH * ratio);
          const normCanvas = document.createElement('canvas');
          normCanvas.width = targetW;
          normCanvas.height = targetH;
          normCanvas.getContext('2d').drawImage(img, 0, 0, targetW, targetH);
          loadSourceImage(normCanvas, false);
          showToast('高解像度画像を最適サイズにリサイズして読み込みました');
        } else {
          loadSourceImage(img, false);
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(objectUrl);
        showToast('画像データの読み込みに失敗しました');
      };
      img.src = objectUrl;
    }

    function createDemoScreenshotCanvas() {
      const w = 960;
      const h = 640;
      const c = document.createElement('canvas');
      c.width = w;
      c.height = h;
      const g = c.getContext('2d');

      g.fillStyle = '#f8fafc';
      g.fillRect(0, 0, w, h);

      g.fillStyle = '#e2e8f0';
      g.fillRect(0, 0, w, 44);
      ['#ef4444', '#f59e0b', '#10b981'].forEach((col, i) => {
        g.fillStyle = col;
        g.beginPath();
        g.arc(24 + i * 20, 22, 6, 0, Math.PI * 2);
        g.fill();
      });
      g.fillStyle = '#ffffff';
      drawRoundRectPath(g, 110, 9, w - 140, 26, 8);
      g.fill();
      g.fillStyle = '#64748b';
      g.font = '13px sans-serif';
      g.fillText('https://example.com/secret-dashboard', 126, 27);

      g.fillStyle = '#ffffff';
      drawRoundRectPath(g, 40, 72, w - 80, 150, 16);
      g.fill();
      g.strokeStyle = '#cbd5e1';
      g.lineWidth = 1.5;
      g.stroke();

      g.fillStyle = '#0f172a';
      g.font = 'bold 26px sans-serif';
      g.fillText('プロジェクト進捗レポート（極秘テスト画像）', 68, 120);
      g.fillStyle = '#475569';
      g.font = '17px sans-serif';
      g.fillText('担当者：かたかた  /  メール：sample@example.com  /  公開予定：来週金曜', 68, 160);
      g.fillStyle = '#2563eb';
      g.font = 'bold 16px sans-serif';
      g.fillText('※ 下のエリアを四角枠・全体・ブラシでぼかして試せます', 68, 196);

      const cards = [
        { title: '売上データサマリー', line: '今月の達成率：128.4%（前年比 +32%）', bg: '#eff6ff', bd: '#bfdbfe' },
        { title: '新機能リリース候補', line: '次期アップデート「AI自動検出モード」開発中', bg: '#fefce8', bd: '#fde68a' },
      ];
      cards.forEach((item, idx) => {
        const y = 250 + idx * 175;
        g.fillStyle = item.bg;
        drawRoundRectPath(g, 40, y, w - 80, 150, 16);
        g.fill();
        g.strokeStyle = item.bd;
        g.stroke();
        g.fillStyle = '#1e293b';
        g.font = 'bold 22px sans-serif';
        g.fillText(item.title, 68, y + 52);
        g.fillStyle = '#334155';
        g.font = '18px sans-serif';
        g.fillText(item.line, 68, y + 96);
      });

      return c;
    }

    function drawRoundRectPath(context, x, y, w, h, r) {
      const radius = Math.max(0, Math.min(r, w / 2, h / 2));
      context.beginPath();
      context.moveTo(x + radius, y);
      context.arcTo(x + w, y, x + w, y + h, radius);
      context.arcTo(x + w, y + h, x, y + h, radius);
      context.arcTo(x, y + h, x, y, radius);
      context.arcTo(x, y, x + w, y, radius);
      context.closePath();
    }

    let layerCounter = 1;
    function loadSourceImage(imgOrCanvas, isDemo = false) {
      state.sourceImage = imgOrCanvas;
      state.imgWidth = imgOrCanvas.width;
      state.imgHeight = imgOrCanvas.height;
      state.layers = [];
      state.selectedLayerId = null;
      state.history = [];
      state.historyIndex = -1;
      state.effectCache.clear();
      state.hoverImgPos = null;
      layerCounter = 1;

      updateEditorAvailability();
      resizeCanvas();
      fitImageToScreen();

      if (isDemo) {
        const l1 = createLayerObject('rect', 'tease', {
          x: Math.round(state.imgWidth * 0.06),
          y: Math.round(state.imgHeight * 0.41),
          w: Math.round(state.imgWidth * 0.88),
          h: Math.round(state.imgHeight * 0.21)
        });
        l1.name = 'チラ見せ枠';
        state.layers.push(l1);
        selectLayer(l1.id);
        showToast('サンプル画像を読み込みました');
      } else {
        const boxW = Math.round(state.imgWidth * 0.55);
        const boxH = Math.round(state.imgHeight * 0.18);
        const initialLayer = createLayerObject('rect', 'tease', {
          x: Math.round((state.imgWidth - boxW) / 2),
          y: Math.round((state.imgHeight - boxH) / 2),
          w: boxW,
          h: boxH
        });
        state.layers.push(initialLayer);
        selectLayer(initialLayer.id);
        showToast('画像を読み込みました');
      }

      pushHistory();
      render();
    }

    function clearAllImageAndLayers() {
      state.sourceImage = null;
      state.imgWidth = 0;
      state.imgHeight = 0;
      state.layers = [];
      state.selectedLayerId = null;
      state.history = [];
      state.historyIndex = -1;
      state.hasUnsavedChanges = false;
      state.effectCache.clear();
      state.hoverImgPos = null;
      hideLoupe();
      renderLayerList();
      updateEditorAvailability();
      ctx.clearRect(0, 0, mainCanvas.width, mainCanvas.height);
      showToast('画像とぼかし設定を一括クリアしました');
    }

    function createLayerObject(shapeType = 'rect', presetName = 'tease', customRect = null) {
      const presets = {
        tease:   { blurType: 'gaussian', strength: 9,  opacity: 0.92, feather: 16, borderRadius: 18 },
        secret:  { blurType: 'gaussian', strength: 28, opacity: 1.00, feather: 10, borderRadius: 12 },
        frosted: { blurType: 'frosted',  strength: 18, opacity: 0.95, feather: 12, borderRadius: 20 },
        mosaic:  { blurType: 'mosaic',   strength: 16, opacity: 1.00, feather: 4,  borderRadius: 10 },
      };
      const p = presets[presetName] || presets.tease;

      const labelMap = { rect: '枠 #', full: '全体 #', brush: 'ブラシ #' };
      const defaultW = Math.max(80, Math.round(state.imgWidth * 0.45));
      const defaultH = Math.max(50, Math.round(state.imgHeight * 0.16));

      return {
        id: 'layer_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
        name: (labelMap[shapeType] || '枠 #') + (layerCounter++),
        shapeType,
        blurType: p.blurType,
        strength: p.strength,
        opacity: p.opacity,
        feather: p.feather,
        borderRadius: p.borderRadius,
        badge: '',
        rect: customRect || {
          x: Math.round((state.imgWidth - defaultW) / 2),
          y: Math.round((state.imgHeight - defaultH) / 2),
          w: defaultW,
          h: defaultH
        },
        strokes: [],
        erasers: [],
        visible: true
      };
    }

    function getSelectedLayer() {
      return state.layers.find(l => l.id === state.selectedLayerId) || null;
    }

    function selectLayer(id) {
      state.selectedLayerId = id;
      const layer = getSelectedLayer();
      if (layer) {
        if (layer.shapeType === 'rect' && (state.activeTool === 'brush' || state.activeTool === 'pan')) {
          setActiveTool('rect');
        } else if (layer.shapeType === 'brush' && state.activeTool === 'rect') {
          setActiveTool('brush');
        } else if (layer.shapeType === 'full' && state.activeTool === 'rect') {
          setActiveTool('eraser');
        }
        syncControlsFromLayer(layer);
      }
      renderLayerList();
      render();
    }

    // --- エフェクト生成（キャッシュ4枚制限でSafari落ち防止） ---
    function getLayerEffectCanvas(layer) {
      if (layer.blurType === 'solid-black' || layer.blurType === 'solid-white') {
        const key = layer.blurType;
        if (state.effectCache.has(key)) return state.effectCache.get(key);
        const ec = document.createElement('canvas');
        ec.width = state.imgWidth;
        ec.height = state.imgHeight;
        const ectx = ec.getContext('2d');
        ectx.fillStyle = layer.blurType === 'solid-black' ? '#0f172a' : '#ffffff';
        ectx.fillRect(0, 0, state.imgWidth, state.imgHeight);
        storeInEffectCache(key, ec);
        return ec;
      }

      const key = `${layer.blurType}_${layer.strength}`;
      if (state.effectCache.has(key)) {
        const cached = state.effectCache.get(key);
        state.effectCache.delete(key);
        state.effectCache.set(key, cached);
        return cached;
      }

      const w = state.imgWidth;
      const h = state.imgHeight;
      const ec = document.createElement('canvas');
      ec.width = w;
      ec.height = h;
      const ectx = ec.getContext('2d');

      const scaleFactor = getScaleFactor();
      const scaledStrength = Math.max(1, layer.strength * scaleFactor);

      if (layer.blurType === 'gaussian' || layer.blurType === 'frosted') {
        applyGaussianBlur(ectx, state.sourceImage, w, h, scaledStrength);
        if (layer.blurType === 'frosted') {
          ectx.fillStyle = 'rgba(255, 255, 255, 0.22)';
          ectx.fillRect(0, 0, w, h);
          const pat = ectx.createPattern(frostedNoisePattern, 'repeat');
          if (pat) {
            ectx.fillStyle = pat;
            ectx.fillRect(0, 0, w, h);
          }
        }
      } else if (layer.blurType === 'mosaic') {
        const blockSize = Math.max(3, Math.round(scaledStrength * 1.4));
        const sw = Math.max(1, Math.round(w / blockSize));
        const sh = Math.max(1, Math.round(h / blockSize));
        const temp = document.createElement('canvas');
        temp.width = sw;
        temp.height = sh;
        const tctx = temp.getContext('2d');
        tctx.imageSmoothingEnabled = true;
        tctx.drawImage(state.sourceImage, 0, 0, sw, sh);

        ectx.imageSmoothingEnabled = false;
        ectx.drawImage(temp, 0, 0, sw, sh, 0, 0, w, h);
        ectx.imageSmoothingEnabled = true;
      } else if (layer.blurType === 'motion') {
        const distance = Math.max(4, Math.round(scaledStrength * 2.2));
        const steps = 18;
        ectx.globalAlpha = 1 / steps;
        for (let i = 0; i < steps; i++) {
          const offset = ((i / (steps - 1)) - 0.5) * distance;
          ectx.drawImage(state.sourceImage, offset, 0, w, h);
        }
        ectx.globalAlpha = 1;
      }

      storeInEffectCache(key, ec);
      return ec;
    }

    function storeInEffectCache(key, canvas) {
      if (state.effectCache.size >= MAX_EFFECT_CACHE) {
        const oldestKey = state.effectCache.keys().next().value;
        state.effectCache.delete(oldestKey);
      }
      state.effectCache.set(key, canvas);
    }

    function applyGaussianBlur(targetCtx, img, w, h, blurPx) {
      if (supportsCanvasFilter) {
        const pad = Math.ceil(blurPx * 2.5);
        const pw = w + pad * 2;
        const ph = h + pad * 2;
        const temp = document.createElement('canvas');
        temp.width = pw;
        temp.height = ph;
        const tctx = temp.getContext('2d');
        tctx.drawImage(img, pad, pad, w, h);
        tctx.drawImage(img, 0, 0, w, 1, pad, 0, w, pad);
        tctx.drawImage(img, 0, h - 1, w, 1, pad, pad + h, w, pad);
        tctx.drawImage(img, 0, 0, 1, h, 0, pad, pad, h);
        tctx.drawImage(img, w - 1, 0, 1, h, pad + w, pad, pad, h);

        targetCtx.save();
        targetCtx.filter = `blur(${blurPx.toFixed(1)}px)`;
        targetCtx.drawImage(temp, pad, pad, w, h, 0, 0, w, h);
        targetCtx.restore();
      } else {
        const passes = 4;
        const factor = Math.max(2, Math.min(24, blurPx * 0.7));
        const sw = Math.max(1, Math.round(w / factor));
        const sh = Math.max(1, Math.round(h / factor));
        const temp = document.createElement('canvas');
        temp.width = sw;
        temp.height = sh;
        const tctx = temp.getContext('2d');
        tctx.imageSmoothingEnabled = true;
        tctx.drawImage(img, 0, 0, sw, sh);

        targetCtx.save();
        targetCtx.imageSmoothingEnabled = true;
        targetCtx.globalAlpha = 0.5;
        for (let i = 0; i < passes; i++) {
          const jitter = (i - passes / 2) * 0.8;
          targetCtx.drawImage(temp, 0, 0, sw, sh, jitter, jitter, w, h);
        }
        targetCtx.restore();
      }
    }

    const workLayerCanvas = document.createElement('canvas');
    const workLayerCtx = workLayerCanvas.getContext('2d');

    function drawLayerBadge(destCtx, layer) {
      if (!layer.badge || !layer.visible) return;
      let cx = state.imgWidth / 2;
      let cy = state.imgHeight / 2;
      if (layer.shapeType === 'rect') {
        cx = layer.rect.x + layer.rect.w / 2;
        cy = layer.rect.y + layer.rect.h / 2;
      } else if (layer.shapeType === 'brush' && layer.strokes.length > 0) {
        let sumX = 0, sumY = 0, count = 0;
        layer.strokes.forEach(s => s.points.forEach(p => { sumX += p.x; sumY += p.y; count++; }));
        if (count > 0) { cx = sumX / count; cy = sumY / count; }
      }

      const scaleFactor = getScaleFactor();
      let fontSize = Math.max(12, Math.round(24 * scaleFactor));
      destCtx.save();
      destCtx.font = `bold ${fontSize}px "Inter", "Noto Sans JP", sans-serif`;
      let metrics = destCtx.measureText(layer.badge);
      let padX = Math.round(fontSize * 0.8);
      let bw = metrics.width + padX * 2;
      if (layer.shapeType === 'rect' && bw > layer.rect.w * 0.9 && layer.rect.w > 24) {
        const fitRatio = (layer.rect.w * 0.9) / bw;
        fontSize = Math.max(10, Math.floor(fontSize * fitRatio));
        destCtx.font = `bold ${fontSize}px "Inter", "Noto Sans JP", sans-serif`;
        metrics = destCtx.measureText(layer.badge);
        padX = Math.round(fontSize * 0.7);
        bw = metrics.width + padX * 2;
      }
      const padY = Math.round(fontSize * 0.45);
      const bh = fontSize + padY * 2;

      destCtx.shadowColor = 'rgba(15, 23, 42, 0.2)';
      destCtx.shadowBlur = 10 * scaleFactor;
      destCtx.shadowOffsetY = 3 * scaleFactor;
      destCtx.fillStyle = 'rgba(15, 23, 42, 0.86)';
      drawRoundRectPath(destCtx, cx - bw / 2, cy - bh / 2, bw, bh, bh / 2);
      destCtx.fill();

      destCtx.shadowColor = 'transparent';
      destCtx.fillStyle = '#ffffff';
      destCtx.textAlign = 'center';
      destCtx.textBaseline = 'middle';
      destCtx.fillText(layer.badge, cx, cy + 1);
      destCtx.restore();
    }

    function compositeSingleLayer(destCtx, layer) {
      if (!layer.visible) return;
      const w = state.imgWidth;
      const h = state.imgHeight;
      const scaleFactor = getScaleFactor();
      const featherPx = Math.round(layer.feather * scaleFactor);
      const effectCanvas = getLayerEffectCanvas(layer);

      if (layer.shapeType === 'rect' && (!layer.erasers || layer.erasers.length === 0)) {
        const r = layer.rect;
        const pad = Math.ceil(featherPx * 2.5) + 4;
        const bx = Math.max(0, Math.floor(r.x - pad));
        const by = Math.max(0, Math.floor(r.y - pad));
        const bx2 = Math.min(w, Math.ceil(r.x + r.w + pad));
        const by2 = Math.min(h, Math.ceil(r.y + r.h + pad));
        const bw = bx2 - bx;
        const bh = by2 - by;
        if (bw <= 0 || bh <= 0) return;

        if (workLayerCanvas.width !== w || workLayerCanvas.height !== h) {
          workLayerCanvas.width = w;
          workLayerCanvas.height = h;
        }
        workLayerCtx.clearRect(bx, by, bw, bh);

        workLayerCtx.save();
        if (featherPx > 0 && supportsCanvasFilter) {
          workLayerCtx.filter = `blur(${featherPx}px)`;
        }
        workLayerCtx.fillStyle = '#000000';
        const inset = Math.min(featherPx * 0.35, Math.min(r.w, r.h) * 0.25);
        drawRoundRectPath(
          workLayerCtx,
          r.x + inset,
          r.y + inset,
          Math.max(2, r.w - inset * 2),
          Math.max(2, r.h - inset * 2),
          layer.borderRadius * scaleFactor
        );
        workLayerCtx.fill();
        workLayerCtx.restore();

        workLayerCtx.save();
        workLayerCtx.globalCompositeOperation = 'source-in';
        workLayerCtx.drawImage(effectCanvas, bx, by, bw, bh, bx, by, bw, bh);
        workLayerCtx.restore();

        destCtx.save();
        destCtx.globalAlpha = layer.opacity;
        destCtx.drawImage(workLayerCanvas, bx, by, bw, bh, bx, by, bw, bh);
        destCtx.restore();
        drawLayerBadge(destCtx, layer);
        return;
      }

      if (workLayerCanvas.width !== w || workLayerCanvas.height !== h) {
        workLayerCanvas.width = w;
        workLayerCanvas.height = h;
      }
      workLayerCtx.clearRect(0, 0, w, h);

      workLayerCtx.save();
      if (layer.shapeType === 'full') {
        workLayerCtx.fillStyle = '#000000';
        workLayerCtx.fillRect(0, 0, w, h);
      } else {
        if (featherPx > 0 && supportsCanvasFilter) {
          workLayerCtx.filter = `blur(${featherPx}px)`;
        }
        workLayerCtx.fillStyle = '#000000';
        workLayerCtx.strokeStyle = '#000000';
        workLayerCtx.lineCap = 'round';
        workLayerCtx.lineJoin = 'round';

        if (layer.shapeType === 'rect') {
          const r = layer.rect;
          const inset = Math.min(featherPx * 0.35, Math.min(r.w, r.h) * 0.25);
          drawRoundRectPath(
            workLayerCtx,
            r.x + inset,
            r.y + inset,
            Math.max(2, r.w - inset * 2),
            Math.max(2, r.h - inset * 2),
            layer.borderRadius * scaleFactor
          );
          workLayerCtx.fill();
        } else if (layer.shapeType === 'brush') {
          layer.strokes.forEach(stroke => drawSmoothStroke(workLayerCtx, stroke.points, stroke.size));
        }
      }
      workLayerCtx.restore();

      if (layer.erasers && layer.erasers.length > 0) {
        workLayerCtx.save();
        workLayerCtx.globalCompositeOperation = 'destination-out';
        if (supportsCanvasFilter) {
          workLayerCtx.filter = `blur(${Math.max(2, Math.round(4 * scaleFactor))}px)`;
        }
        workLayerCtx.strokeStyle = '#000000';
        workLayerCtx.fillStyle = '#000000';
        workLayerCtx.lineCap = 'round';
        workLayerCtx.lineJoin = 'round';
        layer.erasers.forEach(eraser => drawSmoothStroke(workLayerCtx, eraser.points, eraser.size));
        workLayerCtx.restore();
      }

      workLayerCtx.save();
      workLayerCtx.globalCompositeOperation = 'source-in';
      workLayerCtx.drawImage(effectCanvas, 0, 0);
      workLayerCtx.restore();

      destCtx.save();
      destCtx.globalAlpha = layer.opacity;
      destCtx.drawImage(workLayerCanvas, 0, 0);
      destCtx.restore();
      drawLayerBadge(destCtx, layer);
    }

    function drawSmoothStroke(c, points, size) {
      if (!points || points.length === 0) return;
      if (points.length === 1) {
        c.beginPath();
        c.arc(points[0].x, points[0].y, size / 2, 0, Math.PI * 2);
        c.fill();
        return;
      }
      c.lineWidth = size;
      c.beginPath();
      c.moveTo(points[0].x, points[0].y);
      for (let i = 1; i < points.length - 1; i++) {
        const xc = (points[i].x + points[i + 1].x) / 2;
        const yc = (points[i].y + points[i + 1].y) / 2;
        c.quadraticCurveTo(points[i].x, points[i].y, xc, yc);
      }
      const last = points[points.length - 1];
      c.lineTo(last.x, last.y);
      c.stroke();
    }

    function renderFinalImageToCanvas(fillWhiteBg = false) {
      const out = document.createElement('canvas');
      out.width = state.imgWidth;
      out.height = state.imgHeight;
      const octx = out.getContext('2d');
      if (fillWhiteBg) {
        octx.fillStyle = '#ffffff';
        octx.fillRect(0, 0, out.width, out.height);
      }
      octx.drawImage(state.sourceImage, 0, 0);
      state.layers.forEach(layer => compositeSingleLayer(octx, layer));
      return out;
    }

    function render() {
      const cw = mainCanvas.width;
      const ch = mainCanvas.height;
      ctx.clearRect(0, 0, cw, ch);
      if (!state.sourceImage) return;

      ctx.save();
      ctx.translate(state.view.offsetX, state.view.offsetY);
      ctx.scale(state.view.scale, state.view.scale);

      ctx.save();
      ctx.shadowColor = 'rgba(15, 23, 42, 0.14)';
      ctx.shadowBlur = 24 / state.view.scale;
      ctx.shadowOffsetY = 6 / state.view.scale;
      ctx.drawImage(state.sourceImage, 0, 0);
      ctx.restore();

      if (!state.isComparing) {
        state.layers.forEach(layer => compositeSingleLayer(ctx, layer));
        const sel = getSelectedLayer();
        if (sel && sel.visible && sel.shapeType === 'rect' && state.activeTool !== 'pan') {
          drawSelectionBoxUI(ctx, sel);
        }
      }

      if ((state.activeTool === 'brush' || state.activeTool === 'eraser') && state.hoverImgPos) {
        const r = getScaledBrushSize() / 2;
        const invScale = 1 / state.view.scale;
        ctx.save();
        ctx.beginPath();
        ctx.arc(state.hoverImgPos.x, state.hoverImgPos.y, r, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';
        ctx.lineWidth = 3 * invScale;
        ctx.stroke();
        ctx.strokeStyle = state.activeTool === 'eraser' ? '#e11d48' : '#2563eb';
        ctx.lineWidth = 1.6 * invScale;
        ctx.stroke();
        ctx.restore();
      }

      ctx.restore();
    }

    function drawSelectionBoxUI(c, layer) {
      const r = layer.rect;
      const invScale = 1 / state.view.scale;

      c.save();
      c.strokeStyle = 'rgba(255, 255, 255, 0.92)';
      c.lineWidth = 3.5 * invScale;
      drawRoundRectPath(c, r.x, r.y, r.w, r.h, layer.borderRadius * getScaleFactor());
      c.stroke();

      c.strokeStyle = '#2563eb';
      c.lineWidth = 2 * invScale;
      c.setLineDash([6 * invScale, 4 * invScale]);
      c.stroke();
      c.setLineDash([]);

      const handles = getRectHandles(r);
      const handleRadius = 6.5 * invScale;
      Object.values(handles).forEach(pt => {
        c.beginPath();
        c.arc(pt.x, pt.y, handleRadius, 0, Math.PI * 2);
        c.fillStyle = '#ffffff';
        c.fill();
        c.lineWidth = 2.4 * invScale;
        c.strokeStyle = '#2563eb';
        c.stroke();
      });
      c.restore();
    }

    function getRectHandles(r) {
      return {
        nw: { x: r.x, y: r.y },
        n:  { x: r.x + r.w / 2, y: r.y },
        ne: { x: r.x + r.w, y: r.y },
        e:  { x: r.x + r.w, y: r.y + r.h / 2 },
        se: { x: r.x + r.w, y: r.y + r.h },
        s:  { x: r.x + r.w / 2, y: r.y + r.h },
        sw: { x: r.x, y: r.y + r.h },
        w:  { x: r.x, y: r.y + r.h / 2 },
      };
    }

    // --- リアルタイム拡大ルーペ ---
    const loupePatchCanvas = document.createElement('canvas');
    const loupePatchCtx = loupePatchCanvas.getContext('2d');

    function updateLoupe(imgX, imgY) {
      if (!state.sourceImage) return;
      loupeContainer.classList.remove('hidden');
      const lw = loupeCanvas.width;
      const lh = loupeCanvas.height;
      const zoom = 2.2;
      const srcSize = lw / zoom;
      const sx = imgX - srcSize / 2;
      const sy = imgY - srcSize / 2;

      if (loupePatchCanvas.width !== lw || loupePatchCanvas.height !== lh) {
        loupePatchCanvas.width = lw;
        loupePatchCanvas.height = lh;
      }

      loupeCtx.clearRect(0, 0, lw, lh);
      loupeCtx.drawImage(state.sourceImage, sx, sy, srcSize, srcSize, 0, 0, lw, lh);

      const scaleFactor = getScaleFactor();
      state.layers.forEach(layer => {
        if (!layer.visible) return;
        const effectCanvas = getLayerEffectCanvas(layer);
        const featherPx = Math.round(layer.feather * scaleFactor);

        loupePatchCtx.clearRect(0, 0, lw, lh);
        loupePatchCtx.save();
        loupePatchCtx.scale(zoom, zoom);
        loupePatchCtx.translate(-sx, -sy);

        if (layer.shapeType === 'full') {
          loupePatchCtx.fillStyle = '#000000';
          loupePatchCtx.fillRect(0, 0, state.imgWidth, state.imgHeight);
        } else {
          if (featherPx > 0 && supportsCanvasFilter) {
            loupePatchCtx.filter = `blur(${featherPx}px)`;
          }
          loupePatchCtx.fillStyle = '#000000';
          loupePatchCtx.strokeStyle = '#000000';
          loupePatchCtx.lineCap = 'round';
          loupePatchCtx.lineJoin = 'round';

          if (layer.shapeType === 'rect') {
            const r = layer.rect;
            const inset = Math.min(featherPx * 0.35, Math.min(r.w, r.h) * 0.25);
            drawRoundRectPath(
              loupePatchCtx,
              r.x + inset,
              r.y + inset,
              Math.max(2, r.w - inset * 2),
              Math.max(2, r.h - inset * 2),
              layer.borderRadius * scaleFactor
            );
            loupePatchCtx.fill();
          } else if (layer.shapeType === 'brush') {
            layer.strokes.forEach(stroke => drawSmoothStroke(loupePatchCtx, stroke.points, stroke.size));
          }
        }
        loupePatchCtx.restore();

        if (layer.erasers && layer.erasers.length > 0) {
          loupePatchCtx.save();
          loupePatchCtx.globalCompositeOperation = 'destination-out';
          if (supportsCanvasFilter) {
            loupePatchCtx.filter = `blur(${Math.max(2, Math.round(4 * scaleFactor * zoom))}px)`;
          }
          loupePatchCtx.scale(zoom, zoom);
          loupePatchCtx.translate(-sx, -sy);
          loupePatchCtx.strokeStyle = '#000000';
          loupePatchCtx.fillStyle = '#000000';
          loupePatchCtx.lineCap = 'round';
          loupePatchCtx.lineJoin = 'round';
          layer.erasers.forEach(eraser => drawSmoothStroke(loupePatchCtx, eraser.points, eraser.size));
          loupePatchCtx.restore();
        }

        loupePatchCtx.save();
        loupePatchCtx.globalCompositeOperation = 'source-in';
        loupePatchCtx.drawImage(effectCanvas, sx, sy, srcSize, srcSize, 0, 0, lw, lh);
        loupePatchCtx.restore();

        loupeCtx.save();
        loupeCtx.globalAlpha = layer.opacity;
        loupeCtx.drawImage(loupePatchCanvas, 0, 0);
        loupeCtx.restore();
      });

      const radiusOnLoupe = (getScaledBrushSize() / 2) * zoom;
      loupeCtx.beginPath();
      loupeCtx.arc(lw / 2, lh / 2, Math.max(3, radiusOnLoupe), 0, Math.PI * 2);
      loupeCtx.strokeStyle = state.activeTool === 'eraser' ? '#e11d48' : '#2563eb';
      loupeCtx.lineWidth = 2;
      loupeCtx.stroke();
    }

    function hideLoupe() {
      loupeContainer.classList.add('hidden');
    }

    // --- 座標＆ズーム ---
    function resizeCanvas() {
      const rect = canvasContainer.getBoundingClientRect();
      mainCanvas.width = rect.width;
      mainCanvas.height = rect.height;
      if (state.sourceImage) render();
    }

    function updateZoomLabel() {
      zoomLabel.textContent = Math.round(state.view.scale * 100) + '%';
    }

    function fitImageToScreen() {
      if (!state.sourceImage) return;
      const cw = mainCanvas.width;
      const ch = mainCanvas.height;
      const padding = 28;
      const scaleX = (cw - padding * 2) / state.imgWidth;
      const scaleY = (ch - padding * 2) / state.imgHeight;
      state.view.scale = Math.min(scaleX, scaleY, 1.5);
      state.view.offsetX = (cw - state.imgWidth * state.view.scale) / 2;
      state.view.offsetY = (ch - state.imgHeight * state.view.scale) / 2;
      updateZoomLabel();
      render();
    }

    function zoomAtCenter(factor) {
      if (!state.sourceImage) return;
      const cx = mainCanvas.width / 2;
      const cy = mainCanvas.height / 2;
      const newScale = Math.max(0.15, Math.min(6, state.view.scale * factor));
      const ratio = newScale / state.view.scale;
      state.view.offsetX = cx - (cx - state.view.offsetX) * ratio;
      state.view.offsetY = cy - (cy - state.view.offsetY) * ratio;
      state.view.scale = newScale;
      updateZoomLabel();
      render();
    }

    function clientToImageCoords(clientX, clientY) {
      const rect = mainCanvas.getBoundingClientRect();
      return {
        x: (clientX - rect.left - state.view.offsetX) / state.view.scale,
        y: (clientY - rect.top - state.view.offsetY) / state.view.scale
      };
    }

    // --- ポインター操作 ---
    function handleTouchStart(e) {
      if (!state.sourceImage) return;
      e.preventDefault();
      if (e.touches.length === 2) {
        hideLoupe();
        const t1 = e.touches[0];
        const t2 = e.touches[1];
        state.gesture.mode = 'pinch';
        state.gesture.initialPinchDist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
        state.gesture.initialScale = state.view.scale;
        state.gesture.lastClientX = (t1.clientX + t2.clientX) / 2;
        state.gesture.lastClientY = (t1.clientY + t2.clientY) / 2;
        return;
      }
      if (e.touches.length === 1) {
        startSinglePointerAction(e.touches[0].clientX, e.touches[0].clientY);
      }
    }

    function handleTouchMove(e) {
      if (!state.sourceImage) return;
      e.preventDefault();
      if (e.touches.length === 2 && state.gesture.mode === 'pinch') {
        const t1 = e.touches[0];
        const t2 = e.touches[1];
        const dist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
        const midX = (t1.clientX + t2.clientX) / 2;
        const midY = (t1.clientY + t2.clientY) / 2;

        state.view.offsetX += midX - state.gesture.lastClientX;
        state.view.offsetY += midY - state.gesture.lastClientY;

        const rect = mainCanvas.getBoundingClientRect();
        const cx = midX - rect.left;
        const cy = midY - rect.top;
        const newScale = Math.max(0.15, Math.min(6, state.gesture.initialScale * (dist / state.gesture.initialPinchDist)));
        const ratio = newScale / state.view.scale;
        state.view.offsetX = cx - (cx - state.view.offsetX) * ratio;
        state.view.offsetY = cy - (cy - state.view.offsetY) * ratio;
        state.view.scale = newScale;

        state.gesture.lastClientX = midX;
        state.gesture.lastClientY = midY;
        updateZoomLabel();
        render();
        return;
      }
      if (e.touches.length === 1) {
        moveSinglePointerAction(e.touches[0].clientX, e.touches[0].clientY);
      }
    }

    function handleTouchEnd(e) {
      if (e.touches.length === 0) {
        state.hoverImgPos = null;
        endSinglePointerAction();
      }
    }

    function handleMouseDown(e) {
      if (!state.sourceImage || e.button !== 0) return;
      startSinglePointerAction(e.clientX, e.clientY);
    }

    function handleMouseMove(e) {
      if (!state.sourceImage) return;
      if (state.gesture.mode === 'none') {
        updateMouseCursor(e.clientX, e.clientY);
        return;
      }
      moveSinglePointerAction(e.clientX, e.clientY);
    }

    function handleMouseUp() {
      endSinglePointerAction();
    }

    function handleWheel(e) {
      if (!state.sourceImage) return;
      e.preventDefault();
      const rect = mainCanvas.getBoundingClientRect();
      const cx = e.clientX - rect.left;
      const cy = e.clientY - rect.top;
      const zoomFactor = e.deltaY < 0 ? 1.12 : 0.89;
      const newScale = Math.max(0.15, Math.min(6, state.view.scale * zoomFactor));
      const ratio = newScale / state.view.scale;
      state.view.offsetX = cx - (cx - state.view.offsetX) * ratio;
      state.view.offsetY = cy - (cy - state.view.offsetY) * ratio;
      state.view.scale = newScale;
      updateZoomLabel();
      render();
    }

    function startSinglePointerAction(clientX, clientY) {
      const pt = clientToImageCoords(clientX, clientY);
      state.gesture.startImgX = pt.x;
      state.gesture.startImgY = pt.y;
      state.gesture.startClientX = clientX;
      state.gesture.startClientY = clientY;
      state.gesture.lastClientX = clientX;
      state.gesture.lastClientY = clientY;
      state.gesture.didMutate = false;
      state.hoverImgPos = pt;

      if (state.activeTool === 'pan') {
        state.gesture.mode = 'pan';
        return;
      }

      const sel = getSelectedLayer();

      if (state.activeTool === 'rect') {
        if (sel && sel.visible && sel.shapeType === 'rect') {
          const hitHandle = hitTestRectHandles(sel.rect, pt.x, pt.y);
          if (hitHandle) {
            state.gesture.mode = 'resize_rect';
            state.gesture.handle = hitHandle;
            state.gesture.origRect = { ...sel.rect };
            state.gesture.didMutate = true;
            return;
          }
        }

        for (let i = state.layers.length - 1; i >= 0; i--) {
          const l = state.layers[i];
          if (l.visible && l.shapeType === 'rect' && isPointInRect(pt.x, pt.y, l.rect)) {
            selectLayer(l.id);
            state.gesture.mode = 'move_rect';
            state.gesture.origRect = { ...l.rect };
            state.gesture.didMutate = true;
            return;
          }
        }

        state.gesture.mode = 'pending_create_rect';
        return;
      }

      if (state.activeTool === 'brush') {
        let targetLayer = sel;
        if (!targetLayer || targetLayer.shapeType !== 'brush') {
          targetLayer = createLayerObject('brush', 'tease');
          state.layers.push(targetLayer);
          selectLayer(targetLayer.id);
        }
        targetLayer.visible = true;
        targetLayer.strokes.push({ points: [{ x: pt.x, y: pt.y }], size: getScaledBrushSize() });
        state.gesture.mode = 'draw_brush';
        state.gesture.didMutate = true;
        updateLoupe(pt.x, pt.y);
        render();
        return;
      }

      if (state.activeTool === 'eraser') {
        if (!sel) {
          showToast('先に消しゴムをかけるレイヤーを選択してください');
          return;
        }
        sel.erasers.push({ points: [{ x: pt.x, y: pt.y }], size: getScaledBrushSize() });
        state.gesture.mode = 'draw_eraser';
        state.gesture.didMutate = true;
        updateLoupe(pt.x, pt.y);
        render();
      }
    }

    function moveSinglePointerAction(clientX, clientY) {
      const pt = clientToImageCoords(clientX, clientY);
      state.hoverImgPos = pt;
      let sel = getSelectedLayer();

      if (state.gesture.mode === 'pan') {
        state.view.offsetX += clientX - state.gesture.lastClientX;
        state.view.offsetY += clientY - state.gesture.lastClientY;
        state.gesture.lastClientX = clientX;
        state.gesture.lastClientY = clientY;
        render();
        return;
      }

      if (state.gesture.mode === 'pending_create_rect') {
        const dist = Math.hypot(clientX - state.gesture.startClientX, clientY - state.gesture.startClientY);
        if (dist < DRAG_CREATE_THRESHOLD_PX) return;
        const newLayer = createLayerObject('rect', 'tease', {
          x: state.gesture.startImgX,
          y: state.gesture.startImgY,
          w: 16,
          h: 16
        });
        state.layers.push(newLayer);
        selectLayer(newLayer.id);
        sel = newLayer;
        state.gesture.mode = 'create_rect';
        state.gesture.didMutate = true;
      }

      if (state.gesture.mode === 'create_rect' && sel) {
        const x1 = Math.min(state.gesture.startImgX, pt.x);
        const y1 = Math.min(state.gesture.startImgY, pt.y);
        const w = Math.max(16, Math.abs(pt.x - state.gesture.startImgX));
        const h = Math.max(16, Math.abs(pt.y - state.gesture.startImgY));
        sel.rect = { x: x1, y: y1, w, h };
        render();
        return;
      }

      if (state.gesture.mode === 'move_rect' && sel && state.gesture.origRect) {
        sel.rect.x = state.gesture.origRect.x + (pt.x - state.gesture.startImgX);
        sel.rect.y = state.gesture.origRect.y + (pt.y - state.gesture.startImgY);
        render();
        return;
      }

      if (state.gesture.mode === 'resize_rect' && sel && state.gesture.origRect) {
        const o = state.gesture.origRect;
        const hnd = state.gesture.handle;
        let left = o.x;
        let top = o.y;
        let right = o.x + o.w;
        let bottom = o.y + o.h;

        if (hnd.includes('e')) right = pt.x;
        if (hnd.includes('w')) left = pt.x;
        if (hnd.includes('s')) bottom = pt.y;
        if (hnd.includes('n')) top = pt.y;

        sel.rect = {
          x: Math.min(left, right),
          y: Math.min(top, bottom),
          w: Math.max(20, Math.abs(right - left)),
          h: Math.max(20, Math.abs(bottom - top))
        };
        render();
        return;
      }

      if (state.gesture.mode === 'draw_brush' && sel && sel.strokes.length > 0) {
        sel.strokes[sel.strokes.length - 1].points.push({ x: pt.x, y: pt.y });
        updateLoupe(pt.x, pt.y);
        render();
        return;
      }

      if (state.gesture.mode === 'draw_eraser' && sel && sel.erasers.length > 0) {
        sel.erasers[sel.erasers.length - 1].points.push({ x: pt.x, y: pt.y });
        updateLoupe(pt.x, pt.y);
        render();
      }
    }

    function endSinglePointerAction() {
      if (state.gesture.didMutate) {
        pushHistory();
      }
      state.gesture.mode = 'none';
      state.gesture.handle = null;
      state.gesture.didMutate = false;
      hideLoupe();
      render();
    }

    function hitTestRectHandles(r, imgX, imgY) {
      const handles = getRectHandles(r);
      const hitRadius = 18 / state.view.scale;
      for (const [key, pt] of Object.entries(handles)) {
        if (Math.hypot(imgX - pt.x, imgY - pt.y) <= hitRadius) return key;
      }
      return null;
    }

    function isPointInRect(x, y, r) {
      return x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h;
    }

    function updateMouseCursor(clientX, clientY) {
      const rect = mainCanvas.getBoundingClientRect();
      const insideCanvas = clientX >= rect.left && clientX <= rect.right && clientY >= rect.top && clientY <= rect.bottom;
      if (!insideCanvas) {
        if (state.hoverImgPos) {
          state.hoverImgPos = null;
          render();
        }
        return;
      }

      const pt = clientToImageCoords(clientX, clientY);
      state.hoverImgPos = pt;

      if (state.activeTool === 'pan') {
        mainCanvas.style.cursor = 'grab';
        return;
      }
      if (state.activeTool === 'brush' || state.activeTool === 'eraser') {
        mainCanvas.style.cursor = 'none';
        render();
        return;
      }
      const sel = getSelectedLayer();
      if (sel && sel.visible && sel.shapeType === 'rect') {
        const hnd = hitTestRectHandles(sel.rect, pt.x, pt.y);
        if (hnd) {
          mainCanvas.style.cursor = `${hnd}-resize`;
          return;
        }
        if (isPointInRect(pt.x, pt.y, sel.rect)) {
          mainCanvas.style.cursor = 'move';
          return;
        }
      }
      mainCanvas.style.cursor = 'crosshair';
    }

    // --- UI同期 ---
    function syncControlsFromLayer(layer) {
      if (!layer) return;
      const isSolid = layer.blurType === 'solid-black' || layer.blurType === 'solid-white';

      strengthGroup.classList.toggle('opacity-40', isSolid);
      strengthGroup.classList.toggle('pointer-events-none', isSolid);
      sliderStrength.disabled = isSolid;
      sliderStrength.value = layer.strength;
      valStrength.textContent = isSolid ? '—' : layer.strength;

      const opPct = Math.round(layer.opacity * 100);
      sliderOpacity.value = opPct;
      valOpacity.textContent = opPct + '%';

      sliderFeather.value = layer.feather;
      valFeather.textContent = layer.feather;

      const isBrushMode = state.activeTool === 'brush' || state.activeTool === 'eraser' || layer.shapeType === 'brush';
      const isFullOnly = layer.shapeType === 'full' && !isBrushMode;

      featherGroup.classList.toggle('opacity-40', layer.shapeType === 'full');
      featherGroup.classList.toggle('pointer-events-none', layer.shapeType === 'full');
      sliderFeather.disabled = layer.shapeType === 'full';
      if (layer.shapeType === 'full') valFeather.textContent = '—';

      if (isBrushMode) {
        shapeParamGroup.classList.remove('opacity-40', 'pointer-events-none');
        sliderShapeParam.disabled = false;
        labelShapeParam.textContent = 'ブラシ太さ';
        sliderShapeParam.min = 10;
        sliderShapeParam.max = 120;
        sliderShapeParam.value = state.brushSize;
        valShapeParam.textContent = state.brushSize;
      } else if (isFullOnly) {
        shapeParamGroup.classList.add('opacity-40', 'pointer-events-none');
        sliderShapeParam.disabled = true;
        labelShapeParam.textContent = '角丸（全体では無効）';
        valShapeParam.textContent = '—';
      } else {
        shapeParamGroup.classList.remove('opacity-40', 'pointer-events-none');
        sliderShapeParam.disabled = false;
        labelShapeParam.textContent = '角丸';
        sliderShapeParam.min = 0;
        sliderShapeParam.max = 100;
        sliderShapeParam.value = layer.borderRadius;
        valShapeParam.textContent = layer.borderRadius;
      }

      document.querySelectorAll('.blurtype-btn').forEach(btn => {
        const isMatch = btn.dataset.blurtype === layer.blurType;
        btn.className = isMatch
          ? 'blurtype-btn py-1.5 rounded-lg text-[11px] bg-blue-600 text-white font-bold transition shadow-sm'
          : 'blurtype-btn py-1.5 rounded-lg text-[11px] font-medium text-slate-600 hover:text-slate-900 transition';
      });

      document.querySelectorAll('.badge-btn').forEach(btn => {
        const isMatch = btn.dataset.badge === (layer.badge || '');
        btn.className = isMatch
          ? 'badge-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-blue-600 text-white border border-blue-600 transition'
          : 'badge-btn px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 transition';
      });
    }

    function setActiveTool(toolName) {
      state.activeTool = toolName;
      document.querySelectorAll('.tool-btn').forEach(btn => {
        const isMatch = btn.dataset.tool === toolName;
        btn.className = isMatch
          ? 'tool-btn py-1.5 rounded-lg text-[11px] font-bold flex items-center justify-center gap-1 transition bg-white text-slate-900 shadow-sm'
          : 'tool-btn py-1.5 rounded-lg text-[11px] font-medium flex items-center justify-center gap-1 transition text-slate-600 hover:text-slate-900';
      });

      const hints = {
        rect: 'ドラッグで新規枠作成 / 枠の角でサイズ調整',
        brush: '指やマウスでなぞって自由にぼかし（拡大鏡付き）',
        eraser: '選択中レイヤーの一部をなぞってピンポイント解除',
        pan: 'ドラッグで画面移動 / ホイール・2本指ピンチで拡大縮小'
      };
      hintPill.textContent = hints[toolName] || '';

      const sel = getSelectedLayer();
      if (sel) syncControlsFromLayer(sel);
      render();
    }

    function renderLayerList() {
      layerList.innerHTML = '';
      if (state.layers.length === 0) {
        const empty = document.createElement('span');
        empty.className = 'text-[11px] text-slate-400 py-1';
        empty.textContent = 'レイヤーはありません（上の＋ボタンから追加）';
        layerList.appendChild(empty);
        return;
      }

      const iconMap = { rect: '⬜', full: '🖼️', brush: '🖌️' };
      state.layers.forEach(layer => {
        const isSelected = layer.id === state.selectedLayerId;
        const wrapper = document.createElement('div');
        wrapper.className = isSelected
          ? 'shrink-0 flex items-center rounded-xl bg-blue-50 border border-blue-500 text-blue-900 text-xs font-bold shadow-sm overflow-hidden'
          : 'shrink-0 flex items-center rounded-xl bg-slate-100 border border-slate-200 hover:border-slate-300 text-slate-700 text-xs font-medium overflow-hidden';

        const selectBtn = document.createElement('button');
        selectBtn.type = 'button';
        selectBtn.className = 'px-2.5 py-1.5 flex items-center gap-1';
        const iconSpan = document.createElement('span');
        iconSpan.textContent = iconMap[layer.shapeType] || '⬜';
        const nameSpan = document.createElement('span');
        nameSpan.textContent = layer.name;
        if (!layer.visible) nameSpan.classList.add('line-through', 'opacity-50');
        selectBtn.appendChild(iconSpan);
        selectBtn.appendChild(nameSpan);
        selectBtn.addEventListener('click', () => selectLayer(layer.id));

        const eyeBtn = document.createElement('button');
        eyeBtn.type = 'button';
        eyeBtn.className = 'pr-2 pl-1 py-1.5 text-[11px] opacity-70 hover:opacity-100';
        eyeBtn.title = layer.visible ? '一時的に非表示' : '表示する';
        eyeBtn.textContent = layer.visible ? '👁' : '🙈';
        eyeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          layer.visible = !layer.visible;
          pushHistory();
          renderLayerList();
          render();
        });

        wrapper.appendChild(selectBtn);
        wrapper.appendChild(eyeBtn);
        layerList.appendChild(wrapper);
      });
    }

    // --- イベント登録 ---
    window.addEventListener('resize', resizeCanvas);
    window.addEventListener('load', () => {
      resizeCanvas();
      updateEditorAvailability();
      renderLayerList();
    });

    mainCanvas.addEventListener('mouseleave', () => {
      if (state.hoverImgPos) {
        state.hoverImgPos = null;
        render();
      }
    });

    btnToggleMobilePanel.addEventListener('click', () => {
      state.mobilePanelCollapsed = !state.mobilePanelCollapsed;
      sidebarBody.classList.toggle('hidden', state.mobilePanelCollapsed);
      btnToggleMobilePanel.textContent = state.mobilePanelCollapsed ? '▲ 設定を開く' : '▼ たたむ';
      requestAnimationFrame(resizeCanvas);
    });

    window.addEventListener('beforeunload', (e) => {
      if (state.sourceImage && state.hasUnsavedChanges) {
        e.preventDefault();
        e.returnValue = '';
      }
    });

    function handleFileInputChange(e) {
      const file = e.target.files && e.target.files[0];
      processUploadedFile(file);
      e.target.value = '';
    }
    document.getElementById('imageInput').addEventListener('change', handleFileInputChange);
    document.getElementById('welcomeImageInput').addEventListener('change', handleFileInputChange);

    ['dragenter', 'dragover'].forEach(evtName => {
      window.addEventListener(evtName, (e) => {
        e.preventDefault();
        dropZone.classList.add('border-blue-500', 'bg-blue-50/60');
      });
    });
    ['dragleave', 'drop'].forEach(evtName => {
      window.addEventListener(evtName, (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-blue-500', 'bg-blue-50/60');
      });
    });
    window.addEventListener('drop', (e) => {
      const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (file) processUploadedFile(file);
    });

    window.addEventListener('paste', (e) => {
      const items = e.clipboardData && e.clipboardData.items;
      if (!items) return;
      for (const item of items) {
        if (item.type.startsWith('image/')) {
          const blob = item.getAsFile();
          if (blob) {
            processUploadedFile(blob);
            break;
          }
        }
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        helpModal.classList.add('hidden');
        xPreviewModal.classList.add('hidden');
        confirmClearModal.classList.add('hidden');
        return;
      }
      if (!state.sourceImage) return;
      const sel = getSelectedLayer();

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        if (e.shiftKey) redo();
        else undo();
        return;
      }

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y') {
        e.preventDefault();
        redo();
        return;
      }

      if (e.key === 'Delete' || e.key === 'Backspace') {
        if (document.activeElement && document.activeElement.tagName === 'INPUT') return;
        e.preventDefault();
        document.getElementById('btnDeleteLayer').click();
        return;
      }

      if (sel && sel.shapeType === 'rect' && ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
        if (document.activeElement && document.activeElement.type === 'range') return;
        e.preventDefault();
        const step = e.shiftKey ? 10 : 1;
        if (e.key === 'ArrowUp') sel.rect.y -= step;
        if (e.key === 'ArrowDown') sel.rect.y += step;
        if (e.key === 'ArrowLeft') sel.rect.x -= step;
        if (e.key === 'ArrowRight') sel.rect.x += step;
        pushHistory();
        render();
      }
    });

    btnUndo.addEventListener('click', undo);
    btnRedo.addEventListener('click', redo);

    const confirmClearModal = document.getElementById('confirmClearModal');
    btnClearAll.addEventListener('click', () => {
      if (!state.sourceImage) return;
      confirmClearModal.classList.remove('hidden');
    });
    document.getElementById('btnCancelClear').addEventListener('click', () => confirmClearModal.classList.add('hidden'));
    document.getElementById('btnConfirmClear').addEventListener('click', () => {
      confirmClearModal.classList.add('hidden');
      clearAllImageAndLayers();
    });

    const helpModal = document.getElementById('helpModal');
    document.getElementById('btnHelp').addEventListener('click', () => helpModal.classList.remove('hidden'));
    document.getElementById('btnSidebarHelp').addEventListener('click', () => helpModal.classList.remove('hidden'));
    document.getElementById('btnCloseHelp').addEventListener('click', () => helpModal.classList.add('hidden'));
    document.getElementById('btnCloseHelpBottom').addEventListener('click', () => helpModal.classList.add('hidden'));

    document.getElementById('btnLoadDemo').addEventListener('click', () => {
      loadSourceImage(createDemoScreenshotCanvas(), true);
    });

    mainCanvas.addEventListener('touchstart', handleTouchStart, { passive: false });
    mainCanvas.addEventListener('touchmove', handleTouchMove, { passive: false });
    mainCanvas.addEventListener('touchend', handleTouchEnd);
    mainCanvas.addEventListener('mousedown', handleMouseDown);
    window.addEventListener('mousemove', handleMouseMove);
    window.addEventListener('mouseup', handleMouseUp);
    mainCanvas.addEventListener('wheel', handleWheel, { passive: false });

    document.getElementById('btnAddRectLayer').addEventListener('click', () => {
      if (!state.sourceImage) return;
      const l = createLayerObject('rect', 'tease');
      state.layers.push(l);
      setActiveTool('rect');
      selectLayer(l.id);
      pushHistory();
      showToast('新しい四角枠を追加しました');
    });

    document.getElementById('btnAddFullLayer').addEventListener('click', () => {
      if (!state.sourceImage) return;
      const l = createLayerObject('full', 'tease');
      state.layers.push(l);
      setActiveTool('eraser');
      selectLayer(l.id);
      pushHistory();
      showToast('全体ぼかしを追加しました（消しゴムで見せたい部分を抜けます）');
    });

    document.getElementById('btnAddBrushLayer').addEventListener('click', () => {
      if (!state.sourceImage) return;
      const l = createLayerObject('brush', 'tease');
      state.layers.push(l);
      setActiveTool('brush');
      selectLayer(l.id);
      pushHistory();
      showToast('なぞってぼかせるブラシを追加しました');
    });

    document.getElementById('btnDuplicateLayer').addEventListener('click', () => {
      const sel = getSelectedLayer();
      if (!sel) return;
      const offset = Math.round(Math.min(state.imgWidth, state.imgHeight) * 0.04);
      const copy = {
        ...sel,
        id: 'layer_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
        name: sel.name + ' コピー',
        rect: { x: sel.rect.x + offset, y: sel.rect.y + offset, w: sel.rect.w, h: sel.rect.h },
        strokes: sel.strokes.map(s => ({ size: s.size, points: s.points.map(p => ({ x: p.x + offset, y: p.y + offset })) })),
        erasers: sel.erasers.map(e => ({ size: e.size, points: e.points.map(p => ({ x: p.x + offset, y: p.y + offset })) }))
      };
      state.layers.push(copy);
      selectLayer(copy.id);
      pushHistory();
      showToast('レイヤーを複製しました');
    });

    document.getElementById('btnDeleteLayer').addEventListener('click', () => {
      const sel = getSelectedLayer();
      if (!sel) return;
      state.layers = state.layers.filter(l => l.id !== sel.id);
      const next = state.layers[state.layers.length - 1] || null;
      state.selectedLayerId = next ? next.id : null;
      if (next) syncControlsFromLayer(next);
      pushHistory();
      renderLayerList();
      render();
      showToast('レイヤーを削除しました');
    });

    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', () => setActiveTool(btn.dataset.tool));
    });

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!state.sourceImage) return;
        let sel = getSelectedLayer();
        if (!sel) {
          sel = createLayerObject('rect', btn.dataset.preset);
          state.layers.push(sel);
        }
        const map = {
          tease:   { blurType: 'gaussian', strength: 9,  opacity: 0.90, feather: 16, label: '✨ 匂わせチラ見せ' },
          secret:  { blurType: 'gaussian', strength: 30, opacity: 1.00, feather: 10, label: '🔒 完全シークレット' },
          frosted: { blurType: 'frosted',  strength: 18, opacity: 0.95, feather: 12, label: '🧊 すりガラス' },
          mosaic:  { blurType: 'mosaic',   strength: 16, opacity: 1.00, feather: 4,  label: '👾 モザイク' },
        };
        const cfg = map[btn.dataset.preset];
        if (!cfg) return;
        sel.blurType = cfg.blurType;
        sel.strength = cfg.strength;
        sel.opacity = cfg.opacity;
        sel.feather = cfg.feather;
        selectLayer(sel.id);
        pushHistory();
        showToast(`${cfg.label} を適用しました`);
      });
    });

    document.querySelectorAll('.blurtype-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const sel = getSelectedLayer();
        if (!sel) return;
        sel.blurType = btn.dataset.blurtype;
        if (sel.blurType === 'solid-black' || sel.blurType === 'solid-white') {
          sel.opacity = 1;
        }
        syncControlsFromLayer(sel);
        pushHistory();
        render();
      });
    });

    document.querySelectorAll('.badge-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const sel = getSelectedLayer();
        if (!sel) return;
        sel.badge = btn.dataset.badge;
        syncControlsFromLayer(sel);
        pushHistory();
        render();
      });
    });

    sliderStrength.addEventListener('input', (e) => {
      const sel = getSelectedLayer();
      if (!sel) return;
      sel.strength = Number(e.target.value);
      valStrength.textContent = sel.strength;
      scheduleRender();
    });
    sliderStrength.addEventListener('change', pushHistory);

    sliderOpacity.addEventListener('input', (e) => {
      const sel = getSelectedLayer();
      if (!sel) return;
      const pct = Number(e.target.value);
      sel.opacity = pct / 100;
      valOpacity.textContent = pct + '%';
      scheduleRender();
    });
    sliderOpacity.addEventListener('change', pushHistory);

    sliderFeather.addEventListener('input', (e) => {
      const sel = getSelectedLayer();
      if (!sel) return;
      sel.feather = Number(e.target.value);
      valFeather.textContent = sel.feather;
      scheduleRender();
    });
    sliderFeather.addEventListener('change', pushHistory);

    sliderShapeParam.addEventListener('input', (e) => {
      const sel = getSelectedLayer();
      const val = Number(e.target.value);
      valShapeParam.textContent = val;
      if (state.activeTool === 'brush' || state.activeTool === 'eraser' || (sel && sel.shapeType === 'brush')) {
        state.brushSize = val;
        scheduleRender();
      } else if (sel) {
        sel.borderRadius = val;
        scheduleRender();
      }
    });
    sliderShapeParam.addEventListener('change', () => {
      const sel = getSelectedLayer();
      if (sel && sel.shapeType === 'rect' && state.activeTool !== 'brush' && state.activeTool !== 'eraser') {
        pushHistory();
      }
    });

    document.getElementById('btnZoomIn').addEventListener('click', () => zoomAtCenter(1.2));
    document.getElementById('btnZoomOut').addEventListener('click', () => zoomAtCenter(0.83));
    document.getElementById('btnResetView').addEventListener('click', fitImageToScreen);

    const btnCompare = document.getElementById('btnCompare');
    const startCompare = (e) => { e.preventDefault(); state.isComparing = true; render(); };
    const endCompare = () => { if (state.isComparing) { state.isComparing = false; render(); } };
    btnCompare.addEventListener('mousedown', startCompare);
    btnCompare.addEventListener('touchstart', startCompare, { passive: false });
    window.addEventListener('mouseup', endCompare);
    window.addEventListener('touchend', endCompare);
    window.addEventListener('touchcancel', endCompare);

    const xPreviewModal = document.getElementById('xPreviewModal');
    btnXPreview.addEventListener('click', () => {
      if (!state.sourceImage) return;
      const mergedCanvas = renderFinalImageToCanvas();
      document.getElementById('xPreviewImg').src = mergedCanvas.toDataURL('image/png');
      xPreviewModal.classList.remove('hidden');
    });
    document.getElementById('btnCloseXModal').addEventListener('click', () => xPreviewModal.classList.add('hidden'));
    document.getElementById('btnCloseXModalBottom').addEventListener('click', () => xPreviewModal.classList.add('hidden'));

    // クリップボードへコピー（PNGとして即貼り付け可能）
    btnCopyClipboard.addEventListener('click', async () => {
      if (!state.sourceImage) return;
      if (!navigator.clipboard || typeof ClipboardItem === 'undefined') {
        showToast('お使いのブラウザ環境ではクリップボードコピーに非対応です');
        return;
      }
      const mergedCanvas = renderFinalImageToCanvas();
      mergedCanvas.toBlob(async (blob) => {
        if (!blob) return;
        try {
          await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
          state.hasUnsavedChanges = false;
          showToast('画像をコピーしました！SNSなどにそのまま貼り付けできます');
        } catch (err) {
          showToast('コピーに失敗しました（「保存」ボタンをご利用ください）');
        }
      }, 'image/png');
    });

    // PNG / JPEG / WebP 形式別保存（Exif自動除去）
    btnExport.addEventListener('click', () => {
      if (!state.sourceImage) return;
      const mime = exportFormat.value || 'image/png';
      const extMap = { 'image/png': 'png', 'image/jpeg': 'jpg', 'image/webp': 'webp' };
      const ext = extMap[mime] || 'png';
      const quality = mime === 'image/png' ? undefined : 0.92;

      const mergedCanvas = renderFinalImageToCanvas(mime === 'image/jpeg');
      mergedCanvas.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
        a.href = url;
        a.download = `blurcraft_${timestamp}.${ext}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        state.hasUnsavedChanges = false;
        showToast(`Exif除去済みの${ext.toUpperCase()}を保存しました！`);
      }, mime, quality);
    });
  </script>
</body>
</html>
