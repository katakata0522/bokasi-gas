<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>ぼかしメーカー｜画像・スクショのぼかし＆チラ見せ加工ツール</title>
  <meta name="description" content="画像やスクリーンショットの全体・四角枠・ブラシで自在にぼかせる無料Webツール。濃さ・角丸・黒塗り・スタンプ・クリップボードコピー対応。ブラウザ内処理で安心。">
  <meta name="theme-color" content="#ffffff">

  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Inter"', '"Noto Sans JP"', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <style>
    body {
      overscroll-behavior: none;
      user-select: none;
      -webkit-user-select: none;
      height: 100dvh;
      overflow: hidden;
    }

    #mainCanvas {
      touch-action: none;
    }

    .checkerboard-light {
      background-color: #f8fafc;
      background-image:
        linear-gradient(45deg, #e2e8f0 25%, transparent 25%),
        linear-gradient(-45deg, #e2e8f0 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #e2e8f0 75%),
        linear-gradient(-45deg, transparent 75%, #e2e8f0 75%);
      background-size: 20px 20px;
      background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
    }

    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 6px;
      border-radius: 999px;
      background: #e2e8f0;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #2563eb;
      border: 2.5px solid #ffffff;
      margin-top: -6px;
      box-shadow: 0 2px 5px rgba(37, 99, 235, 0.35), 0 0 0 1px rgba(15, 23, 42, 0.08);
      transition: transform 0.1s ease, background-color 0.1s ease;
    }
    input[type="range"]:active::-webkit-slider-thumb {
      transform: scale(1.16);
      background: #1d4ed8;
    }
    input[type="range"]:focus-visible {
      outline: 2px solid #3b82f6;
      outline-offset: 4px;
      border-radius: 8px;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col h-[100dvh] font-sans antialiased selection:bg-blue-100 selection:text-blue-900">

  <!-- ツールヘッダー -->
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 px-3 sm:px-5 py-2.5 flex items-center justify-between gap-2 shrink-0 z-30">
    <div class="flex items-center gap-2 min-w-0">
      <span class="font-bold text-base sm:text-lg tracking-tight text-slate-900 truncate">ぼかしメーカー</span>
      <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 text-blue-700 border border-blue-200">v2.2</span>
    </div>

    <!-- 右アクション -->
    <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
      <button id="btnHelp" type="button" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200/80 active:scale-95 transition text-xs font-bold text-slate-700 border border-slate-200 flex items-center justify-center" title="使い方とQ&A">?</button>

      <div class="h-4 w-[1px] bg-slate-200 mx-0.5"></div>

      <button id="btnUndo" type="button" disabled class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200/80 disabled:opacity-40 disabled:pointer-events-none active:scale-95 transition text-sm font-bold text-slate-700 border border-slate-200 flex items-center justify-center" title="元に戻す (Ctrl+Z)">↶</button>
      <button id="btnRedo" type="button" disabled class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200/80 disabled:opacity-40 disabled:pointer-events-none active:scale-95 transition text-sm font-bold text-slate-700 border border-slate-200 flex items-center justify-center" title="やり直す (Ctrl+Y / Ctrl+Shift+Z)">↷</button>

      <div class="h-4 w-[1px] bg-slate-200 mx-0.5"></div>

      <label class="cursor-pointer px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200/80 active:scale-95 transition text-xs font-semibold text-slate-700 border border-slate-200 flex items-center gap-1" title="画像を読み込む・差し替える">
        <span>画像選択</span>
        <input type="file" id="imageInput" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" class="hidden">
      </label>

      <button id="btnClearAll" type="button" disabled class="px-2.5 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 disabled:opacity-40 disabled:pointer-events-none active:scale-95 transition text-xs font-semibold text-rose-700 border border-rose-200 flex items-center gap-1" title="画像とぼかし設定を一括クリア">
        <span class="hidden sm:inline">一括クリア</span>
        <span class="sm:hidden">クリア</span>
      </button>

      <button id="btnXPreview" type="button" disabled class="px-2.5 py-1.5 rounded-xl bg-white hover:bg-slate-50 disabled:opacity-40 disabled:pointer-events-none active:scale-95 transition text-xs font-semibold text-slate-700 border border-slate-200 flex items-center gap-1.5" title="SNSタイムラインでの見え方をチェック">
        <svg class="w-3.5 h-3.5 text-slate-900" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <span class="hidden md:inline">見栄え確認</span>
      </button>
    </div>
  </header>

  <!-- メイン2ペインスタジオ -->
  <div class="flex-1 flex flex-col lg:flex-row min-h-0 overflow-hidden">

    <!-- 左ペイン：プレビューキャンバスエリア -->
    <main id="canvasContainer" class="relative flex-1 min-h-[36vh] lg:min-h-0 w-full overflow-hidden checkerboard-light flex items-center justify-center">
      <canvas id="mainCanvas" class="block w-full h-full"></canvas>

      <!-- 初期ドロップゾーン -->
      <div id="emptyDropOverlay" class="absolute inset-0 flex items-center justify-center p-4 z-10">
        <div id="dropZone" class="relative max-w-md w-full rounded-3xl border-2 border-dashed border-slate-300 hover:border-blue-500 bg-white/95 backdrop-blur-md shadow-xl p-6 sm:p-8 text-center transition-all cursor-pointer group">
          <input type="file" id="welcomeImageInput" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" aria-label="加工する画像を選択">
          <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:scale-105 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h1 class="text-base sm:text-lg font-bold text-slate-900 mb-1">ここに画像をドロップ、または選択</h1>
          <p class="text-xs text-slate-500 mb-4 leading-relaxed">
            スクリーンショットや写真を <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-slate-100 border border-slate-200 rounded text-slate-700">Ctrl + V</kbd> で直接貼り付けできます。<br>すべてブラウザ内処理でサーバー送信は行いません。
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-2 relative z-20 pointer-events-none">
            <span class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-blue-600 group-hover:bg-blue-700 text-white font-bold text-xs shadow-sm transition">
              画像ファイルを開く
            </span>
            <button id="btnLoadDemo" type="button" class="pointer-events-auto w-full sm:w-auto px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs border border-slate-200 transition">
              サンプル画像で試す →
            </button>
          </div>
        </div>
      </div>

      <!-- 右上フローティングHUD（元画像比較） -->
      <div id="floatingHud" class="hidden absolute top-3 right-3 flex items-center gap-1.5 z-10">
        <button id="btnCompare" type="button" class="px-3 py-1.5 rounded-full bg-white/95 hover:bg-slate-50 text-slate-700 text-xs font-semibold border border-slate-200 shadow-sm backdrop-blur-md flex items-center gap-1.5 active:bg-blue-600 active:text-white active:border-blue-600 transition" title="押している間だけ元の画像を表示">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span>元画像比較</span>
        </button>
      </div>

      <!-- 右下ズームコントロールHUD -->
      <div id="zoomHud" class="hidden absolute bottom-3 right-3 flex items-center bg-white/95 backdrop-blur-md border border-slate-200 rounded-full shadow-sm p-1 gap-0.5 z-10">
        <button id="btnZoomOut" type="button" class="w-7 h-7 rounded-full hover:bg-slate-100 active:scale-95 text-slate-700 font-bold text-sm flex items-center justify-center transition" title="縮小">−</button>
        <span id="zoomLabel" class="px-2 text-[11px] font-mono font-bold text-slate-700 min-w-[46px] text-center">100%</span>
        <button id="btnZoomIn" type="button" class="w-7 h-7 rounded-full hover:bg-slate-100 active:scale-95 text-slate-700 font-bold text-sm flex items-center justify-center transition" title="拡大">＋</button>
        <div class="w-[1px] h-4 bg-slate-200 mx-0.5"></div>
        <button id="btnResetView" type="button" class="px-2.5 h-7 rounded-full hover:bg-slate-100 active:scale-95 text-slate-700 text-[11px] font-semibold transition" title="画面にフィット">Fit</button>
      </div>

      <!-- リアルタイム拡大ルーペ -->
      <div id="loupeContainer" class="hidden pointer-events-none absolute top-3 left-3 w-28 h-28 rounded-2xl border-2 border-blue-600 shadow-xl overflow-hidden bg-white z-20">
        <canvas id="loupeCanvas" width="112" height="112" class="w-full h-full"></canvas>
        <div class="absolute bottom-1 right-1.5 text-[9px] font-bold text-white bg-blue-600/90 px-1.5 rounded">拡大鏡 2.2x</div>
      </div>

      <!-- 操作ヒントバッジ -->
      <div id="hintPill" class="hidden pointer-events-none absolute bottom-3 left-3 px-3 py-1 rounded-full bg-white/95 text-slate-700 text-[11px] font-medium border border-slate-200 shadow-sm backdrop-blur-sm max-w-[calc(100%-190px)] truncate z-10">
        ドラッグで新規枠作成 / 枠の角でサイズ調整
      </div>
    </main>

    <!-- 右ペイン：設定サイドバー -->
    <aside id="controlPanel" class="w-full lg:w-[368px] xl:w-[392px] max-h-[48vh] lg:max-h-none bg-white border-t lg:border-t-0 lg:border-l border-slate-200 flex flex-col shrink-0 z-20 shadow-[0_-4px_16px_rgba(15,23,42,0.04)] lg:shadow-[-4px_0_16px_rgba(15,23,42,0.03)] transition-all" aria-label="ぼかし設定サイドバー">

      <!-- モバイル用パネル折りたたみハンドル -->
      <div class="flex lg:hidden items-center justify-between px-3.5 py-1.5 border-b border-slate-100 bg-slate-50/70 shrink-0">
        <span class="text-[11px] font-bold text-slate-700">設定パネル</span>
        <button id="btnToggleMobilePanel" type="button" class="px-2.5 py-0.5 rounded-full bg-white border border-slate-200 text-[11px] font-semibold text-slate-600 active:scale-95 transition">
          ▼ たたむ
        </button>
      </div>

      <!-- サイドバーヘッダー（PC向け） -->
      <div class="hidden lg:flex items-center justify-between px-4 py-2.5 border-b border-slate-100 shrink-0">
        <span class="text-xs font-bold text-slate-800 tracking-wide">設定</span>
        <button id="btnSidebarHelp" type="button" class="text-[11px] font-semibold text-blue-600 hover:text-blue-700 hover:underline">使い方とQ&amp;A</button>
      </div>

      <!-- スクロール可能な設定領域 -->
      <div id="sidebarBody" class="lg:!block flex-1 overflow-y-auto px-3.5 py-3 space-y-4 opacity-45 pointer-events-none transition-opacity">

        <!-- 1. レイヤー追加・管理 -->
        <section class="space-y-2">
          <div class="flex items-center justify-between">
            <h2 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">ぼかしを追加・管理</h2>
            <div class="flex items-center gap-1">
              <button id="btnDuplicateLayer" type="button" class="px-2 py-1 rounded-lg bg-slate-100 hover:bg-slate-200/80 text-slate-700 text-[11px] font-semibold border border-slate-200 active:scale-95 transition" title="選択中のレイヤーを複製">複製</button>
              <button id="btnDeleteLayer" type="button" class="px-2 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-[11px] font-semibold border border-rose-200 active:scale-95 transition" title="選択中のレイヤーを削除 (Delete)">削除</button>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-1.5">
            <button id="btnAddRectLayer" type="button" class="py-1.5 px-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-[11px] font-bold active:scale-95 transition">＋ 四角枠</button>
            <button id="btnAddFullLayer" type="button" class="py-1.5 px-2 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 text-[11px] font-bold active:scale-95 transition">＋ 全体</button>
            <button id="btnAddBrushLayer" type="button" class="py-1.5 px-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 text-[11px] font-bold active:scale-95 transition">＋ ブラシ</button>
          </div>

          <div id="layerList" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" role="tablist" aria-label="ぼかしレイヤー一覧"></div>
        </section>

        <!-- 2. キャンバス操作モード -->
        <section class="space-y-1.5">
          <h2 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">キャンバスの操作</h2>
          <div class="grid grid-cols-4 gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200/80">
            <button type="button" data-tool="rect" class="tool-btn py-1.5 rounded-lg text-[11px] font-bold flex items-center justify-center gap-1 transition bg-white text-slate-900 shadow-sm">
              <span>⬜ 枠編集</span>
            </button>
            <button type="button" data-tool="brush" class="tool-btn py-1.5 rounded-lg text-[11px] font-medium flex items-center justify-center gap-1 transition text-slate-600 hover:text-slate-900">
              <span>🖌️ ブラシ</span>
            </button>
            <button type="button" data-tool="eraser" class="tool-btn py-1.5 rounded-lg text-[11px] font-medium flex items-center justify-center gap-1 transition text-slate-600 hover:text-slate-900">
              <span>🧹 消しゴム</span>
            </button>
            <button type="button" data-tool="pan" class="tool-btn py-1.5 rounded-lg text-[11px] font-medium flex items-center justify-center gap-1 transition text-slate-600 hover:text-slate-900">
              <span>✋ 移動</span>
            </button>
          </div>
        </section>

        <!-- 3. ワンタッププリセット -->
        <section class="space-y-1.5">
          <h2 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">ワンタッププリセット</h2>
          <div class="grid grid-cols-2 gap-1.5">
            <button type="button" data-preset="tease" class="preset-btn py-2 px-2 rounded-xl bg-amber-50 hover:bg-amber-100/80 border border-amber-200 text-xs font-bold text-amber-800 active:scale-95 transition text-left">
              ✨ 匂わせチラ見せ
            </button>
            <button type="button" data-preset="secret" class="preset-btn py-2 px-2 rounded-xl bg-rose-50 hover:bg-rose-100/80 border border-rose-200 text-xs font-bold text-rose-800 active:scale-95 transition text-left">
              🔒 完全シークレット
            </button>
            <button type="button" data-preset="frosted" class="preset-btn py-2 px-2 rounded-xl bg-sky-50 hover:bg-sky-100/80 border border-sky-200 text-xs font-bold text-sky-800 active:scale-95 transition text-left">
              🧊 すりガラス
            </button>
            <button type="button" data-preset="mosaic" class="preset-btn py-2 px-2 rounded-xl bg-emerald-50 hover:bg-emerald-100/80 border border-emerald-200 text-xs font-bold text-emerald-800 active:scale-95 transition text-left">
              👾 モザイク
            </button>
          </div>
        </section>

        <!-- 4. ぼかし・隠し質感（黒塗り・白塗り追加） -->
        <section class="space-y-1.5">
          <h2 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">ぼかし・隠しの質感</h2>
          <div class="grid grid-cols-3 gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200/80">
            <button type="button" data-blurtype="gaussian" class="blurtype-btn py-1.5 rounded-lg text-[11px] bg-blue-600 text-white font-bold transition shadow-sm">ガウス</button>
            <button type="button" data-blurtype="frosted" class="blurtype-btn py-1.5 rounded-lg text-[11px] font-medium text-slate-600 hover:text-slate-900 transition">すりガラス</button>
            <button type="button" data-blurtype="mosaic" class="blurtype-btn py-1.5 rounded-lg text-[11px] font-medium text-slate-600 hover:text-slate-900 transition">モザイク</button>
            <button type="button" data-blurtype="motion" class="blurtype-btn py-1.5 rounded-lg text-[11px] font-medium text-slate-600 hover:text-slate-900 transition">モーション</button>
            <button type="button" data-blurtype="solid-black" class="blurtype-btn py-1.5 rounded-lg text-[11px] font-medium text-slate-600 hover:text-slate-900 transition">⬛ 黒塗り</button>
            <button type="button" data-blurtype="solid-white" class="blurtype-btn py-1.5 rounded-lg text-[11px] font-medium text-slate-600 hover:text-slate-900 transition">⬜ 白塗り</button>
          </div>
        </section>

        <!-- 5. 基本調整スライダー -->
        <section class="space-y-3 pt-1">
          <div id="strengthGroup" class="space-y-1 transition-opacity">
            <div class="flex justify-between text-xs">
              <label for="sliderStrength" class="text-slate-700 font-semibold">ぼかし強さ</label>
              <span id="valStrength" class="font-mono text-blue-600 font-bold">9</span>
            </div>
            <input type="range" id="sliderStrength" min="1" max="60" value="9" class="w-full">
          </div>

          <div class="space-y-1">
            <div class="flex justify-between text-xs">
              <label for="sliderOpacity" class="text-slate-700 font-semibold">濃度（透け感）</label>
              <span id="valOpacity" class="font-mono text-blue-600 font-bold">92%</span>
            </div>
            <input type="range" id="sliderOpacity" min="15" max="100" value="92" class="w-full">
          </div>
        </section>

        <!-- 6. チラ見せスタンプ（ラベル重ね） -->
        <section class="space-y-1.5">
          <h2 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">チラ見せスタンプ（枠の中央に表示）</h2>
          <div class="flex flex-wrap gap-1">
            <button type="button" data-badge="" class="badge-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-blue-600 text-white border border-blue-600 transition">なし</button>
            <button type="button" data-badge="？" class="badge-btn px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 transition">？</button>
            <button type="button" data-badge="🔒 SECRET" class="badge-btn px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 transition">🔒 SECRET</button>
            <button type="button" data-badge="👀 チラ見せ" class="badge-btn px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 transition">👀 チラ見せ</button>
            <button type="button" data-badge="⚠️ ネタバレ注意" class="badge-btn px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 transition">⚠️ ネタバレ注意</button>
          </div>
        </section>

        <!-- 7. 詳細調整（アコーディオン） -->
        <details class="group border border-slate-200 rounded-2xl bg-slate-50/70" open>
          <summary class="px-3 py-2.5 text-xs font-bold text-slate-700 cursor-pointer list-none flex items-center justify-between">
            <span>詳細設定（境界・太さ・角丸）</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform text-[10px]">▼</span>
