  <!-- 一括クリア確認モーダル -->
  <div id="confirmClearModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="confirmClearTitle">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-xs w-full p-5 shadow-2xl text-center">
      <h2 id="confirmClearTitle" class="text-base font-bold text-slate-900 mb-1.5">画像と設定をクリアしますか？</h2>
      <p class="text-xs text-slate-600 leading-relaxed mb-5">
        読み込んでいる画像とすべてのぼかしレイヤーがリセットされます。
      </p>
      <div class="grid grid-cols-2 gap-2">
